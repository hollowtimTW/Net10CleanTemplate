@{
    var isAuth = Context.User?.Identity?.IsAuthenticated ?? false;
    var name = Context.User?.Identity?.Name;
}

<ul class="navbar-nav">
@if (isAuth)
{
    <li class="nav-item">
        <span class="nav-link text-light">Hello @(name ?? "User")!</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-page="/Account/Login" method="get">
            <button type="submit" class="nav-link btn btn-link text-light">Switch user</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>